# AMBIENTE
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# BASE DE DATOS
DATABASE_URL=./data/meridian.db
DATABASE_BACKUP_PATH=./data/backups

# SEGURIDAD - JWT (⚠️ CAMBIAR EN PRODUCCIÓN, generar con crypto.randomBytes(48).toString('hex'))
JWT_SECRET=TU_SECRET_KEY_AQUI_MUY_SEGURO
JWT_REFRESH_SECRET=TU_REFRESH_SECRET_AQUI_MUY_SEGURO
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ADMIN INICIAL (se crea automáticamente al primer arranque si no existe ya un admin)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=TU_PASSWORD_SEGURO

# DUEÑO DEL NEGOCIO (capa B / MeridianTech) — su WhatsApp en formato E.164 sin
# '+' (ej. 573142162323). Es el único número autorizado para pedir inventario,
# estados de cuenta o de reservas por WhatsApp. Vacío = ese candado no se abre.
OWNER_WHATSAPP_PHONE=

# BOLD — API de Pagos en línea / Link de Pagos (⚠️ COMPLETAR CON VALORES REALES)
# Merchant WQO5MEMRNS. La URL de la API (https://integrations.api.bold.co/online/link/v1)
# va fija en boldService.js — no es un producto distinto por comercio, no hace
# falta configurarla. BOLD_MERCHANT_ID y BOLD_SECRET_KEY eran del "Botón de
# Pagos" (producto equivocado para esta cuenta) y ya no los usa el código.
BOLD_API_KEY=TU_API_KEY_DE_BOLD
BOLD_WEBHOOK_SECRET=TU_WEBHOOK_SECRET

# EMAIL (⚠️ COMPLETAR CREDENCIALES)
EMAIL_SERVICE=gmail
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_app_password
EMAIL_FROM=MeridianTech <noreply@meridiantech.co>

# SEGURIDAD
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# APLICACIÓN
APP_NAME=MeridianTech
APP_URL=https://tu_dominio.railway.app
ADMIN_URL=https://tu_dominio.railway.app/admin

# MONEDA
DEFAULT_CURRENCY=COP
