# MeridianTech Security Configuration
# This file hardens the web server against common attacks

# Enable HTTPS Strict Transport Security
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

# Prevent Clickjacking
Header always set X-Frame-Options "SAMEORIGIN"

# Prevent MIME Type Sniffing
Header always set X-Content-Type-Options "nosniff"

# Enable XSS Protection
Header always set X-XSS-Protection "1; mode=block"

# Referrer Policy
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Permissions Policy
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

# Content Security Policy - Strict version for static content
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

# Deny access to sensitive files
<FilesMatch "\.(env|json|lock|sql|config|bak|backup|tmp|md|txt)$">
    Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes

# Redirect HTTP to HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Only redirect if not already HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Set proper encoding for HTML
AddType text/html; charset=utf-8 .html

# Cache control - No caching for HTML
<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Cache CSS and JS files for 30 days
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public, immutable"
</FilesMatch>

# Cache images and fonts for 1 year
<FilesMatch "\.(woff|woff2|ttf|eot|svg|gif|png|jpg|jpeg|webp)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>

# Disable access to backups and temp files
<FilesMatch "(\.bak|\.swp|\.tmp|~)$">
    Require all denied
</FilesMatch>

# Log suspicious activity
ErrorDocument 400 "Bad Request"
ErrorDocument 403 "Forbidden"
ErrorDocument 404 "Page Not Found"
ErrorDocument 500 "Server Error"
